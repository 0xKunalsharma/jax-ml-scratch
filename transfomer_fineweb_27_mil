        "\n",
        "if len(all_ids) <= context_length + 1:\n",
        "    raise ValueError(\"Insufficient tokens.\")\n",
        "\n",
        "token_ids = np.asarray(all_ids, dtype=np.int32)\n",
        "\n",
        "# Contiguous 95/5 train/validation split.\n",
        "split = int(len(token_ids) * 0.95)\n",
        "\n",
        "train_tokens_np = token_ids[:split]\n",
        "val_tokens_np = token_ids[split:]\n",
        "\n",
        "if len(val_tokens_np) <= context_length:\n",
        "    raise ValueError(\"Validation corpus is too small.\")\n",
        "\n",
        "train_tokens = JNP.asarray(train_tokens_np)\n",
        "val_tokens = JNP.asarray(val_tokens_np)\n",
        "\n",
        "print(\"Total tokens:\", len(token_ids))\n",
        "print(\"Training tokens:\", len(train_tokens_np))\n",
        "print(\"Validation tokens:\", len(val_tokens_np))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. INITIALIZE PARAMETERS\n",
        "# ============================================================\n",
        "\n",
        "RNG, *keys = random.split(RNG, 18)\n",
        "\n",
        "E = random.normal(\n",
        "    keys[0], (vocab_size, d_model)\n",
        ") * 0.02\n",
        "\n",
        "P = random.normal(\n",
        "    keys[1], (context_length, d_model)\n",
        ") * 0.02\n",
        "\n",
        "Q = random.normal(\n",
        "    keys[2], (d_model, d_model)\n",
        ") / JNP.sqrt(d_model)\n",
        "\n",
        "K = random.normal(\n",
        "    keys[3], (d_model, d_model)\n",
        ") / JNP.sqrt(d_model)\n",
        "\n",
        "V = random.normal(\n",
        "    keys[4], (d_model, d_model)\n",
        ") / JNP.sqrt(d_model)\n",
        "\n",
        "MLP1 = random.normal(\n",
        "    keys[5], (d_model, d_ff)\n",
        ") / JNP.sqrt(d_model)\n",
        "\n",
        "MLP2 = random.normal(\n",
        "    keys[6], (d_ff, d_ff)\n",
        ") / JNP.sqrt(d_ff)\n",
        "\n",
        "MLP3 = random.normal(\n",
        "    keys[7], (d_ff, d_model)\n",
        ") / JNP.sqrt(d_ff)\n",
        "\n",
        "B1 = JNP.zeros((d_ff,))\n",
        "B2 = JNP.zeros((d_ff,))\n",
        "B3 = JNP.zeros((d_model,))\n",
        "\n",
        "gamma1 = JNP.ones((d_model,))\n",
        "beta1 = JNP.zeros((d_model,))\n",
        "\n",
        "gamma2 = JNP.ones((d_model,))\n",
        "beta2 = JNP.zeros((d_model,))\n",
        "\n",
        "W_out = random.normal(\n",
        "    keys[8], (d_model, vocab_size)\n",
        ") * 0.02\n",
        "\n",
        "b_out = JNP.zeros((vocab_size,))\n",
        "\n",
        "params = (\n",
        "    E, P, Q, K, V,\n",
        "    MLP1, MLP2, MLP3,\n",
        "    B1, B2, B3,\n",
        "    gamma1, beta1, gamma2, beta2,\n",
        "    W_out, b_out,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Parameter count:\",\n",
        "    f\"{sum(p.size for p in params):,}\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. CORE OPERATIONS\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit\n",
        "def ReLU(x):\n",
        "    return JNP.maximum(x, 0.0)\n",
        "\n",
        "\n",
        "@JP.jit\n",
        "def layer_norm(x, gamma, beta):\n",
        "    x = x.astype(JNP.float32)\n",
        "\n",
        "    mean = JNP.mean(x, axis=-1, keepdims=True)\n",
        "    variance = JNP.mean(\n",
        "        (x - mean) ** 2,\n",
        "        axis=-1,\n",
        "        keepdims=True,\n",
        "    )\n",
        "\n",
        "    normalized = (x - mean) / JNP.sqrt(variance + 1e-5)\n",
        "\n",
        "    return gamma * normalized + beta\n",
        "\n",
        "\n",
        "@JP.jit\n",
        "def softmax(x):\n",
        "    x = x - JNP.max(x, axis=-1, keepdims=True)\n",
        "    exp_x = JNP.exp(x)\n",
        "\n",
        "    return exp_x / JNP.sum(\n",
        "        exp_x, axis=-1, keepdims=True\n",
        "    )\n",
        "\n",
        "\n",
        "@JP.jit\n",
        "def MLP_forward(x, MLP1, MLP2, MLP3, B1, B2, B3):\n",
        "    h1 = ReLU(x @ MLP1 + B1)\n",
        "    h2 = ReLU(h1 @ MLP2 + B2)\n",
        "\n",
        "    return h2 @ MLP3 + B3\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. TRANSFORMER FORWARD PASS\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit(single-layer post-LN, hand-rolled Muon, 1M FineWeb tokens, final loss 4.9, greedy samples\n",
        "def model_logits(params, input_ids):\n",
        "    (\n",
        "        E, P, Q, K, V,\n",
        "        MLP1, MLP2, MLP3,\n",
        "        B1, B2, B3,\n",
        "        gamma1, beta1, gamma2, beta2,\n",
        "        W_out, b_out,\n",
        "    ) = params\n",
        "\n",
        "    sequence_length = input_ids.shape[-1]\n",
        "\n",
        "    x = E[input_ids]\n",
        "    x = x + P[:sequence_length][None, :, :]\n",
        "\n",
        "    # Single-head causal self-attention.\n",
        "    q = x @ Q\n",
        "    k = x @ K\n",
        "    v = x @ V\n",
        "\n",
        "    scores = (\n",
        "        q @ JNP.swapaxes(k, -1, -2)\n",
        "    ) / JNP.sqrt(\n",
        "        JNP.asarray(d_model, dtype=x.dtype)\n",
        "    )\n",
        "\n",
        "    # Mask future positions before softmax.\n",
        "    mask = JNP.triu(\n",
        "        JNP.ones(\n",
        "            (sequence_length, sequence_length),\n",
        "            dtype=bool,\n",
        "        ),\n",
        "        k=1,\n",
        "    )\n",
        "\n",
        "    scores = JNP.where(\n",
        "        mask[None, :, :],\n",
        "        -1e30,\n",
        "        scores,\n",
        "    )\n",
        "\n",
        "    weights = softmax(scores)\n",
        "    attention_output = weights @ v\n",
        "\n",
        "    # Attention residual and LayerNorm.\n",
        "    x = layer_norm(\n",
        "        x + attention_output,\n",
        "        gamma1,\n",
        "        beta1,\n",
        "    )\n",
        "\n",
        "    # Feed-forward network residual and LayerNorm.\n",
        "    mlp_output = MLP_forward(\n",
        "        x, MLP1, MLP2, MLP3, B1, B2, B3\n",
        "    )\n",
        "\n",
        "    x = layer_norm(\n",
        "        x + mlp_output,\n",
        "        gamma2,\n",
        "        beta2,\n",
        "    )\n",
        "\n",
        "    # Return logits for all vocabulary tokens.\n",
        "    return x @ W_out + b_out\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. NEXT-TOKEN CROSS-ENTROPY LOSS\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit\n",
        "def loss_fn(params, input_ids, targets):\n",
        "    logits = model_logits(params, input_ids)\n",
        "\n",
        "    log_probs = JP.nn.log_softmax(logits, axis=-1)\n",
        "\n",
        "    target_log_probs = JNP.take_along_axis(\n",
        "        log_probs,\n",
        "        targets[..., None],\n",
        "        axis=-1,\n",
        "    ).squeeze(-1)\n",
        "\n",
        "    return -JNP.mean(target_log_probs)\n",
        "\n",
        "\n",
        "loss_and_grad = JP.jit(\n",
        "    JP.value_and_grad(loss_fn)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. EXPERIMENTAL MUON OPTIMIZER\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit\n",
        "def zeropower_via_newton_schulz5(G):\n",
        "    X = G.astype(JNP.float32)\n",
        "    X = X / (JNP.linalg.norm(X) + 1e-7)\n",
        "\n",
        "    # Arrange X so rows <= columns.\n",
        "    transposed = X.shape[0] > X.shape[1]\n",
        "\n",
        "    if transposed:\n",
        "        X = X.T\n",
        "\n",
        "    for _ in range(5):\n",
        "        A = X @ X.T\n",
        "        B = -4.7750 * A + 2.0315 * (A @ A)\n",
        "        X = 3.4445 * X + B @ X\n",
        "\n",
        "    if transposed:\n",
        "        X = X.T\n",
        "\n",
        "    return X.astype(G.dtype)\n",
        "\n",
        "\n",
        "# Muon applies to Q, K, V, MLP1, MLP2 and MLP3.\n",
        "MUON_INDICES = (2, 3, 4, 5, 6, 7)\n",
        "\n",
        "\n",
        "@JP.jit\n",
        "def muon_update(params, grads, momentum_buffers, lr):\n",
        "    # Clip combined global gradient norm.\n",
        "    grad_norm = JNP.sqrt(\n",
        "        sum(\n",
        "            JNP.sum(g.astype(JNP.float32) ** 2)\n",
        "            for g in grads\n",
        "        )\n",
        "    )\n",
        "\n",
        "    clip_scale = JNP.minimum(\n",
        "        1.0,\n",
        "        max_grad_norm / (grad_norm + 1e-6),\n",
        "    )\n",
        "\n",
        "    grads = tuple(g * clip_scale for g in grads)\n",
        "\n",
        "    new_params = []\n",
        "    new_buffers = []\n",
        "\n",
        "    for i, (p, g, buf) in enumerate(\n",
        "        zip(params, grads, momentum_buffers)\n",
        "    ):\n",
        "        new_buf = momentum * buf + g\n",
        "\n",
        "        if i in MUON_INDICES:\n",
        "            direction = g + momentum * new_buf\n",
        "\n",
        "            direction = zeropower_via_newton_schulz5(\n",
        "                direction\n",
        "            )\n",
        "\n",
        "            scale = JNP.sqrt(\n",
        "                max(1.0, p.shape[0] / p.shape[1])\n",
        "            )\n",
        "\n",
        "            new_p = p - lr * scale * direction\n",
        "\n",
        "        else:\n",
        "            # Momentum SGD for non-Muon parameters.\n",
        "            direction = g + momentum * new_buf\n",
        "            new_p = p - lr * direction\n",
        "\n",
        "        new_params.append(new_p)\n",
        "        new_buffers.append(new_buf)\n",
        "\n",
        "    return tuple(new_params), tuple(new_buffers)\n",
        "\n",
        "\n",
        "momentum_buffers = tuple(\n",
        "    JNP.zeros_like(p) for p in params\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. DEVICE-SIDE RANDOM BATCH SAMPLING\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit\n",
        "def get_batch(tokens, rng):\n",
        "    starts = random.randint(\n",
        "        rng,\n",
        "        shape=(batch_size,),\n",
        "        minval=0,\n",
        "        maxval=tokens.shape[0] - context_length,\n",
        "    )\n",
        "\n",
        "    offsets = JNP.arange(context_length + 1)\n",
        "    indices = starts[:, None] + offsets[None, :]\n",
        "\n",
        "    sequences = tokens[indices]\n",
        "\n",
        "    return sequences[:, :-1], sequences[:, 1:]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "@JP.jit\n",
        "def validation_batch_loss(params, input_ids, targets):\n",
        "    return loss_fn(params, input_ids, targets)\n",
        "\n",
        "\n",
        "def evaluate_validation(params, rng, batches=20):\n",
        "    losses = []\n",
        "\n",
        "    for _ in range(batches):\n",
        "        rng, batch_rng = random.split(rng)\n",
        "\n",
        "        inputs, targets = get_batch(\n",
        "            val_tokens, batch_rng\n",
        "        )\n",
        "\n",
        "        loss = validation_batch_loss(\n",
        "            params, inputs, targets\n",
        "        )\n",
        "\n",
        "        losses.append(float(loss))\n",
        "\n",
        "    return float(np.mean(losses)), rng\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. CHECKPOINTS\n",
        "# ============================================================\n",
        "\n",
        "def save_checkpoint(path, params, momentum_buffers, step):\n",
        "    arrays = {}\n",
        "\n",
        "    for i, p in enumerate(params):\n",
        "        arrays[f\"param_{i}\"] = np.asarray(p)\n",
        "\n",
        "    for i, b in enumerate(momentum_buffers):\n",
        "        arrays[f\"buffer_{i}\"] = np.asarray(b)\n",
        "\n",
        "    arrays[\"step\"] = np.asarray(step, dtype=np.int64)\n",
        "\n",
        "    np.savez_compressed(path, **arrays)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. TRAINING LOOP\n",
        "# ============================================================\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "for step in range(training_steps):\n",
        "    RNG, batch_rng = random.split(RNG)\n",
        "\n",
        "    input_ids, targets = get_batch(\n",
        "        train_tokens, batch_rng\n",
        "    )\n",
        "\n",
        "    loss, grads = loss_and_grad(\n",
        "        params, input_ids, targets\n",
        "    )\n",
        "\n",
        "    params, momentum_buffers = muon_update(\n",
        "        params,\n",
        "        grads,\n",
        "        momentum_buffers,\n",
        "        learning_rate,\n",
        "    )\n",
        "\n",
        "    if step % log_every == 0:\n",
        "        loss_value = float(loss)\n",
        "\n",
        "        print(\n",
        "            f\"Step {step:06d} | \"\n",
        "            f\"Train loss: {loss_value:.4f} | \"\n",
        "            f\"Elapsed: {time.time() - start_time:.1f}s\"\n",
        "        )\n",
        "\n",
        "        if not np.isfinite(loss_value):\n",
        "            raise FloatingPointError(\n",
        "                \"Non-finite loss detected.\"\n",
        "            )\n",
        "\n",
        "    if step > 0 and step % checkpoint_every == 0:\n",
        "        path = os.path.join(\n",
        "            checkpoint_dir,\n",
        "            f\"checkpoint_{step:06d}.npz\",\n",
        "        )\n",
        "\n",
        "        save_checkpoint(\n",
        "            path, params, momentum_buffers, step\n",
        "        )\n",
        "\n",
        "        val_loss, RNG = evaluate_validation(params, RNG)\n",
        "\n",
        "        print(\n",
        "            f\"Validation loss at step {step}: \"\n",
        "            f\"{val_loss:.4f}\"\n",
        "        )\n",
        "\n",
        "save_checkpoint(\n",
        "    os.path.join(checkpoint_dir, \"final.npz\"),\n",
        "    params,\n",
        "    momentum_buffers,\n",
        "    training_steps,\n",
        ")\n",
        "\n",
        "print(\"Training complete.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. AUTOREGRESSIVE TEXT GENERATION\n",
        "# ============================================================\n",
        "\n",
        "def generate(prompt, max_new_tokens=50):\n",
        "    generated = list(tokenizer.encode(prompt))\n",
        "\n",
        "    if not generated:\n",
        "        raise ValueError(\"Prompt produced no tokens.\")\n",
        "\n",
        "    for _ in range(max_new_tokens):\n",
        "        context = generated[-context_length:]\n",
        "\n",
        "        input_ids = JNP.asarray(\n",
        "            [context], dtype=JNP.int32\n",
        "        )\n",
        "\n",
        "        logits = model_logits(params, input_ids)\n",
        "        next_logits = logits[0, -1]\n",
        "\n",
        "        # Greedy decoding.\n",
        "        next_token_id = int(JNP.argmax(next_logits))\n",
        "        generated.append(next_token_id)\n",
        "\n",
        "        if next_token_id == eos_token_id:\n",
        "            break\n",
        "\n",
        "    return tokenizer.decode(generated)\n",
        "\n",
        "\n",
        "print(generate(\"Hello, transformer!\", max_new_tokens=50))\n",
        "print(generate(\"Once upon a time\", max_new_tokens=50))\n",
        "print(generate(\"Who are you?\", max_new_tokens=50))\n"
      ]
    }
  ]
