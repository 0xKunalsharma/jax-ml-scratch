      "source": [
        "\n",
        "# ============================================================\n",
        "# JAX TRANSFORMER FROM SCRATCH\n",
        "# FineWeb + GPT-2 tokenizer + experimental Muon\n",
        "#(single-layer post-LN, hand-rolled Muon, 1M FineWeb tokens, final loss 4.9, greedy samples)\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "%pip install datasets gigatoken\n",
        "\n",
        "import os\n",
        "import time\n",
        "import numpy as np\n",
        "\n",
        "import jax as JP\n",
        "import jax.numpy as JNP\n",
        "import jax.random as random\n",
        "\n",
        "from datasets import load_dataset\n",
        "import gigatoken as GT\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "JP.config.update(\"jax_enable_x64\", False)\n",
        "\n",
        "RNG = random.key(0)\n",
        "\n",
        "d_model = 264\n",
        "d_ff = 512\n",
        "vocab_size = 50257\n",
        "context_length = 128\n",
        "\n",
        "batch_size = 8\n",
        "learning_rate = 1e-3\n",
        "momentum = 0.95\n",
        "max_grad_norm = 1.0\n",
        "\n",
        "max_documents = 500000\n",
        "max_tokens = 1_000_000\n",
        "training_steps = 100000\n",
        "\n",
        "log_every = 100\n",
        "checkpoint_every = 10000\n",
        "checkpoint_dir = \"transformer_checkpoints\"\n",
        "\n",
        "os.makedirs(checkpoint_dir, exist_ok=True)\n",
        "\n",
        "eos_token_id = 50256\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. LOAD FINEWEB AND TOKENIZE\n",
        "# ============================================================\n",
        "\n",
        "dataset = load_dataset(\n",
        "    \"HuggingFaceFW/fineweb\",\n",
        "    name=\"sample-10BT\",\n",
        "    split=\"train\",\n",
        "    streaming=True,\n",
        ").take(max_documents)\n",
        "\n",
        "tokenizer = GT.Tokenizer(\"openai-community/gpt2\")\n",
        "all_ids = []\n",
        "\n",
        "for example in dataset:\n",
        "    ids = tokenizer.encode(example[\"text\"])\n",
        "    remaining = max_tokens - len(all_ids)\n",
        "\n",
        "    if remaining <= 1:\n",
        "        break\n",
        "\n",
        "    all_ids.extend(ids[:remaining - 1])\n",
        "    all_ids.append(eos_token_id)\n",
        "\n",
        "    if len(all_ids) >= max_tokens:\n",
        "        all_ids = all_ids[:max_tokens]\n",
